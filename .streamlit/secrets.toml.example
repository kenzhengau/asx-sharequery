# Template for local development. Copy it into place:
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# .streamlit/secrets.toml is git-ignored and must never be committed. The real thing to
# use on a deployment is not this file at all: on Streamlit Community Cloud, paste these
# same lines into the app's "Advanced settings -> Secrets" box (afterwards it lives under
# Settings -> Secrets), because the cloud has no .env and no checkout of your machine.
#
# streamlit_app/app.py copies stored secrets into the environment and then loads settings
# from there, so nothing here needs a code change to take effect.

# The model key. A Platform API key, not a ChatGPT / Codex sign-in token - the API rejects
# those with a 401 and the app says so in plain English at startup.
OPENAI_API_KEY = "sk-..."

# Optional overrides (defaults shown)
# OPENAI_MODEL = "gpt-4o-mini"
# OPENAI_BASE_URL = "https://api.openai.com/v1"

# DeepSeek, as an alternative to OpenAI. Its key alone is enough to select it; add
# LLM_PROVIDER only when both keys are present.
# DEEPSEEK_API_KEY = "sk-..."
# LLM_PROVIDER = "deepseek"

# No SHAREPOINT_* entries here, on purpose. Document reading is switched off in the web
# app, and app.py deletes those variables from the environment before loading settings, so
# adding them would do nothing except leave a credential lying around.
