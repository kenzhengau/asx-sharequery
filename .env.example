# Copy this file to `.env` and fill in your token.

# --- ChatGPT (OpenAI) ----------------------------------------------------------
# The default provider. Get a token from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- DeepSeek (alternative) ----------------------------------------------------
# Optional second provider, used only when OPENAI_API_KEY is unset, or when you set
# LLM_PROVIDER=deepseek explicitly.
# Get a key from https://platform.deepseek.com/api_keys
#
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# --- Provider selection --------------------------------------------------------
# Whichever token is present decides the provider. Set this to choose explicitly; it
# is required if both tokens are configured and you want DeepSeek.
# LLM_PROVIDER=openai

# --- SharePoint library reader (optional) -------------------------------------
# Leave every SHAREPOINT_* variable unset to switch the SharePoint tool off.
# Set SOME but not all and the tool reports exactly what is missing; it will not
# stop the ASX side working.
#
# The app registration needs the 'Sites.Read.All' APPLICATION permission with
# admin consent granted by a tenant admin - without it every call returns 403.
#
# SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000
# SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SHAREPOINT_CLIENT_SECRET=your-client-secret-value
# SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/Research
# SHAREPOINT_LIBRARY=Documents
